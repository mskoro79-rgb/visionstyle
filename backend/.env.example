APP_NAME=VisionStyle API
APP_ENV=development
DEBUG=true

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# MongoDB Compass / mongod connection string. The app runs fine without
# Mongo (falls back to JSON catalog + in-memory session store) but
# persistence requires a real connection here.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=visionstyle

MAX_UPLOAD_SIZE_MB=10

FACE_DETECTION_CONFIDENCE=0.6
POSE_DETECTION_CONFIDENCE=0.5

# composite | idm_vton | catvton | stable_viton
VTON_ENGINE=composite

# Owner authentication (JWT). Change JWT_SECRET_KEY and the bootstrap
# credentials before any real deployment.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-in-.env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
OWNER_BOOTSTRAP_EMAIL=owner@visionstyle.ai
OWNER_BOOTSTRAP_PASSWORD=ChangeMe123!
